# ==========================================================
# .gitignore for Karma Marathon Web Project
# ==========================================================

# Operating System Files
# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/
*.cab
*.msi
*.msix
*.msm
*.msp
*.lnk

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Linux
*~
.fuse_hidden*
.directory
.Trash-*

# Dependencies & Package Managers
node_modules/
jspm_packages/
web_modules/
.pnp
.pnp.js

# Build Outputs & Bundlers
dist/
build/
out/
.next/
.nuxt/
.vuepress/dist
.serverless/
.parcel-cache/

# Logs & Debugging
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Environment Variables & Secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
*.pem
*.key
*.cert

# Editor & IDE Configs
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# Temporary & Scratch Files
tmp/
temp/
*.tmp
*.bak
*.sw?
scratch/
.system_generated/
